#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define BLE  1
#define SYM  2
#define ADJ  3
#define NAV  4
#define WALK 5
#define MOU  6

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    macros {
        tmux_1: tmux_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N1>;
        };
        tmux_2: tmux_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N2>;
        };
        tmux_3: tmux_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N3>;
        };
        tmux_4: tmux_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N4>;
        };
        tmux_5: tmux_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N5>;
        };
        tmux_6: tmux_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N6>;
        };
        tmux_7: tmux_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N7>;
        };
        tmux_8: tmux_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N8>;
        };
        tmux_9: tmux_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N9>;
        };
        tmux_shift_t: tmux_shift_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp LS(T)>;
        };
        bp85: bp85 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(B) &kp LS(P) &kp N8 &kp N5 &kp RET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp DEL
                &kp ESC   &hml LSHFT A &hml LALT S &hml LGUI D &hml LCTRL F &lt NAV G   &lt NAV H &hmr RCTRL J  &hmr RGUI K     &hmr RALT L   &hmr RSHFT SEMI &kp SQT
                &kp CAPS &kp Z &kp X &kp C &lt ADJ V &lt WALK B   &lt WALK N &lt ADJ M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                                &lt BLE LGUI &lt 2 RET &lt MOU ESC   &kp BSPC &lt 2 SPACE &kp RALT
            >;
        };

        ble {
            display-name = "BLE";
            bindings = <
                &kp TAB     &kp N1          &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT   &studio_unlock  &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                                &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &kp EXCL &kp AT &kp HASH &kp DLLR  &kp PRCNT   &kp N7 &kp N8 &kp N9          &kp MINUS &kp UNDER &kp TILDE
                &kp TAB   &kp CARET &kp AMPS &kp KP_MULTIPLY &kp LPAR &kp RPAR   &kp N4 &kp N5 &kp N6 &kp PLUS  &kp N0    &kp KP_MULTIPLY
                &kp LGUI  &kp LCTRL &kp LBKT &kp RBKT &kp LBRC &kp RBRC   &kp N1 &kp N2 &kp N3         &kp DOT   &kp EQUAL &kp GRAVE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &kp C_PREV &kp C_PP   &kp C_NEXT &kp C_BRI_DN &kp C_BRI_UP &trans &trans &kp PSCRN
                &kp F1     &kp F2       &kp F3       &kp F4 &kp F5     &kp F6     &kp F7     &kp F8       &kp F9       &kp F10 &kp F11 &kp F12
                &bt LSHFT &trans &trans &trans &trans &trans   &trans       &trans      &trans       &trans &trans &trans
                                   &kp LGUI &mo BLE &kp SPACE   &kp RET &mo 2 &kp RALT
            >;
        };
        nav {
            display-name = "NAV";
            bindings = <
                &tmux_shift_t &tmux_1 &tmux_2 &tmux_3 &tmux_4 &tmux_5   &tmux_6 &tmux_7 &tmux_8 &tmux_9 &trans &bp85
                &trans &trans  &trans  &trans  &trans  &trans    &kp LEFT &kp DOWN &kp UP &kp RIGHT  &trans &trans
                &trans &kp LA(N1) &kp LA(N2) &kp LA(N3) &kp LA(N4) &kp LA(N5)   &kp LA(N6) &kp LA(N7) &kp LA(N8) &kp LA(N9) &kp LA(N0) &trans
                                       &kp LALT  &kp LGUI  &kp LCTRL    &trans  &trans  &trans
            >;
        };

        walk {
            display-name = "WALK";
            bindings = <
                &trans &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)   &kp LG(N6) &kp LG(N7) &kp LG(N8) &kp LG(N9) &kp LG(N0) &trans
                &trans &kp LC(N1) &kp LC(N2) &kp LC(N3) &kp LC(N4) &kp LC(N5)   &kp LC(N6) &kp LC(N7) &kp LC(N8) &kp LC(N9) &kp LC(N0) &trans
                &kp LG(LC(N1)) &kp LG(LC(N2)) &kp LG(LC(N3)) &kp LG(LC(N4)) &kp LG(LC(N5)) &trans   &trans &kp LG(LC(N6)) &kp LG(LC(N7)) &kp LG(LC(N8)) &kp LG(LC(N9)) &kp LG(LC(N0))
                                             &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };

        mou {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &mkp MCLK &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &mkp RCLK &mkp LCLK &mo BLE   &kp LC(LG(SPACE)) &kp LC(LG(N0)) &kp LC(LG(MINUS)) &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                              &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};